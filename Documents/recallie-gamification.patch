+  {
+    subject: "english", slot: "New learning",
+    q: "A recipe, a story, and a weather report are all examples of what?",
+    type: "mc",
+    options: ["Text types", "Punctuation", "Handwriting styles"],
+    answers: ["Text types"],
+    hint: "Think about how each one is written for a different purpose.",
+    steps: ["Each one has its own purpose and audience.", "A recipe informs, a story entertains, a weather report reports facts.", "They're all different text types!"]
+  },
+  {
+    subject: "maths", slot: "Mix it up",
+    q: "Would you measure the length of your pencil in millimetres, centimetres, or metres?",
+    type: "mc",
+    options: ["Millimetres", "Centimetres", "Metres"],
+    answers: ["Centimetres"],
+    hint: "Is your pencil closer in size to your finger or to a door?",
+    steps: ["A pencil is a small, everyday object.", "Centimetres suit small hand-sized things.", "So centimetres is the best choice!"]
+  },
+  {
+    subject: "english", slot: "Warm-up review",
+    q: "In a recount, what usually comes first?",
+    type: "mc",
+    options: ["The ending", "An orientation (who, when, where)", "A list of ingredients"],
+    answers: ["An orientation (who, when, where)"],
+    hint: "Think about how you'd start telling a friend about your weekend.",
+    steps: ["A recount tells events in the order they happened.", "It starts by setting the scene: who, when, and where.", "That's called the orientation."]
+  }
+];
+
+let idx = 0, stars = 0, streak = 0, bestStreak = 0, correctCount = 0, hintUsed = false;
+
+const speechLines = {
+  start: ["Hi! Ready for today's mission?", "Let's warm up our brains! 🧠", "Six quick questions — you've got this!"],
+  correctStreak: ["Whoa, on fire! 🔥", "You're on a roll!", "Nailed it again!"],
+  correct: ["Yes! Nice thinking!", "That's it!", "Great job!"],
+  retry: ["Good try — let's learn this one together.", "Almost! Here's how it works.", "No worries, mistakes help us grow 🌱"]
+};
+
+function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
+function setSpeech(text) { document.getElementById('speech').textContent = text; }
+function setMascot(e) { document.getElementById('mascot').textContent = e; }
+
+function normalize(s) {
+  return String(s).trim().toLowerCase().replace(/\s+/g, " ").replace(/[.,;:!?]+$/g, "");
+}
+
+function bump(id) {
+  const el = document.getElementById(id);
+  el.classList.remove('pop');
+  void el.offsetWidth;
+  el.classList.add('pop');
+}
+
+function updateProgress() {
+  const pct = (idx / ITEMS.length) * 100;
+  document.getElementById('progressBar').style.width = pct + '%';
+  document.getElementById('progressLabel').textContent = Math.min(idx + 1, ITEMS.length) + ' / ' + ITEMS.length;
+}
+
+function renderQuestion() {
+  hintUsed = false;
+  const item = ITEMS[idx];
+  const card = document.getElementById('questionCard');
+  updateProgress();
+
+  let optionsHtml = '';
+  if (item.type === 'mc') {
+    optionsHtml = '<div class="options">' + item.options.map((o, i) =>
+      `<button class="opt-btn" data-val="${o.replace(/"/g,'&quot;')}" onclick="selectOption(this)">${o}</button>`
+    ).join('') + '</div>';
+  } else {
+    optionsHtml = `<div class="text-input-row">
+      <input type="text" class="text-input" id="answerInput" placeholder="Type your answer…" autocomplete="off" onkeydown="if(event.key==='Enter') submitAnswer()">
+    </div>`;
+  }
+
+  card.innerHTML = `
+    <div class="badge-row">
+      <span class="subject-badge ${item.subject}">${item.subject === 'maths' ? '🔢 Maths' : '📖 English'}</span>
+      <span class="slot-badge">${item.slot}</span>
+    </div>
+    <p class="question-text">${item.q}</p>
+    ${optionsHtml}
+    <div id="hintArea">
+      <button class="hint-btn" onclick="showHint()">💡 Need a hint?</button>
+    </div>
+    <div style="height:14px"></div>
+    <button class="check-btn" id="checkBtn" onclick="submitAnswer()" ${item.type === 'mc' ? 'disabled' : ''}>Check my answer</button>
+  `;
+
+  if (item.type === 'short') {
+    setTimeout(() => document.getElementById('answerInput')?.focus(), 50);
+  }
+}
+
+let selectedOption = null;
+function selectOption(btn) {
+  document.querySelectorAll('.opt-btn').forEach(b => b.classList.remove('selected'));
+  btn.classList.add('selected');
+  selectedOption = btn.dataset.val;
+  document.getElementById('checkBtn').disabled = false;
+}
+
+function showHint() {
+  hintUsed = true;
+  const item = ITEMS[idx];
+  document.getElementById('hintArea').innerHTML =
+    `<div class="hint-box">💡 ${item.hint}</div>`;
+}
+
+function submitAnswer() {
+  const item = ITEMS[idx];
+  let given;
+  if (item.type === 'mc') {
+    given = selectedOption;
+    document.querySelectorAll('.opt-btn').forEach(b => {
+      b.disabled = true;
+      const val = normalize(b.dataset.val);
+      if (item.answers.map(normalize).includes(val)) b.classList.add('correct');
+      else if (b.classList.contains('selected')) b.classList.add('incorrect');
+    });
+  } else {
+    given = document.getElementById('answerInput').value;
+    document.getElementById('answerInput').disabled = true;
+  }
+
+  const isCorrect = item.answers.map(normalize).includes(normalize(given || ''));
+  const card = document.getElementById('questionCard');
+  document.getElementById('checkBtn').remove();
+
+  if (isCorrect) {
+    correctCount++;
+    streak++;
+    bestStreak = Math.max(bestStreak, streak);
+    const gained = hintUsed ? 5 : 10;
+    stars += gained;
+    document.getElementById('starCount').textContent = stars;
+    document.getElementById('streakCount').textContent = streak;
+    bump('starCount'); bump('streakCount');
+    setMascot(streak >= 3 ? '🤩' : '🦊');
+    setSpeech(streak >= 3 ? pick(speechLines.correctStreak) : pick(speechLines.correct));
+    launchConfettiBurst();
+
+    const fb = document.createElement('div');
+    fb.className = 'feedback good';
+    fb.innerHTML = `
+      <h3>Nice work — that's correct! 🎉  <span style="float:right">+${gained}⭐</span></h3>
+      <ol>${item.steps.map(s => `<li>${s}</li>`).join('')}</ol>
+      <button class="next-btn" onclick="nextItem()">Next question →</button>
+    `;
+    card.appendChild(fb);
+  } else {
+    streak = 0;
+    document.getElementById('streakCount').textContent = streak;
+    setMascot('🙂');
+    setSpeech(pick(speechLines.retry));
+
+    const fb = document.createElement('div');
+    fb.className = 'feedback retry';
+    fb.innerHTML = `
+      <h3>Good try — let's see how to get there 🌱</h3>
+      <ol>${item.steps.map(s => `<li>${s}</li>`).join('')}</ol>
+      <button class="next-btn" onclick="nextItem()">Next question →</button>
+    `;
+    card.appendChild(fb);
+  }
+}
+
+function nextItem() {
+  idx++;
+  selectedOption = null;
+  if (idx >= ITEMS.length) {
+    showComplete();
+  } else {
+    renderQuestion();
+  }
+}
+
+function showComplete() {
+  updateProgress();
+  document.getElementById('questionCard').style.display = 'none';
+  document.getElementById('completeCard').style.display = 'block';
+  document.getElementById('finalStars').textContent = stars;
+  document.getElementById('finalStreak').textContent = bestStreak;
+  document.getElementById('finalCorrect').textContent = correctCount + '/' + ITEMS.length;
+
+  let msg = "You smashed today's practice — awesome work!";
+  if (correctCount === ITEMS.length) msg = "Perfect mission! Every single question — incredible! 🌟";
+  else if (correctCount >= ITEMS.length - 1) msg = "So close to perfect — brilliant effort today!";
+  document.getElementById('completeMsg').textContent = msg;
+
+  const stickerSets = ['🌟🦄🎈', '🚀🪐✨', '🐝🌼🍯', '🦕🌈🎉'];
+  document.getElementById('stickers').textContent = pick(stickerSets);
+
+  setMascot('🏆');
+  setSpeech("Mission complete — see you tomorrow!");
+  launchConfettiBurst(true);
+}
+
+function restart() {
+  idx = 0; stars = 0; streak = 0; bestStreak = 0; correctCount = 0;
+  document.getElementById('starCount').textContent = 0;
+  document.getElementById('streakCount').textContent = 0;
+  document.getElementById('completeCard').style.display = 'none';
+  document.getElementById('questionCard').style.display = 'block';
+  setMascot('🦊');
+  setSpeech(pick(speechLines.start));
+  renderQuestion();
+}
+
+/* ---------------- Confetti (lightweight canvas, no libraries) ---------------- */
+const canvas = document.getElementById('confetti');
+const ctx = canvas.getContext('2d');
+function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
+resizeCanvas();
+window.addEventListener('resize', resizeCanvas);
+
+let particles = [];
+const colors = ['#ff6f6f', '#ffc93c', '#4ecb71', '#4fc3f7', '#a78bfa'];
+
+function launchConfettiBurst(big) {
+  const count = big ? 140 : 45;
+  for (let i = 0; i < count; i++) {
+    particles.push({
+      x: canvas.width / 2 + (Math.random() - 0.5) * (big ? canvas.width * 0.6 : 200),
+      y: big ? canvas.height * 0.3 : 160,
+      vx: (Math.random() - 0.5) * 8,
+      vy: Math.random() * -8 - 2,
+      size: Math.random() * 7 + 4,
+      color: colors[Math.floor(Math.random() * colors.length)],
+      rot: Math.random() * 360,
+      vr: (Math.random() - 0.5) * 12,
+      life: 0
+    });
+  }
+}
+
+function animate() {
+  ctx.clearRect(0, 0, canvas.width, canvas.height);
+  particles.forEach(p => {
+    p.vy += 0.28;
+    p.x += p.vx;
+    p.y += p.vy;
+    p.rot += p.vr;
+    p.life++;
+    ctx.save();
+    ctx.translate(p.x, p.y);
+    ctx.rotate(p.rot * Math.PI / 180);
+    ctx.fillStyle = p.color;
+    ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
+    ctx.restore();
+  });
+  particles = particles.filter(p => p.y < canvas.height + 30 && p.life < 220);
+  requestAnimationFrame(animate);
+}
+animate();
+
+/* ---------------- Init ---------------- */
+setSpeech(pick(speechLines.start));
+renderQuestion();
+</script>
+</body>
+</html>
