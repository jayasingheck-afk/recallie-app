+++ b/src/lib/curriculumWeek.ts
@@ -0,0 +1,39 @@
+/**
+ * Derives a child's current curriculum term/week from their enrolment date,
+ * per the project's 10-week-term structure, instead of hard-coding
+ * term 1 / week 1 for everyone.
+ *
+ * MVP content only covers Year 3 Term 1 so far (see src/db/seed/year3-curriculum.json),
+ * so this clamps to term 1 and week 1-10 for now. Once more terms/weeks of
+ * curriculum sequence + item bank content exist, remove the clamp and let it
+ * roll forward naturally (term increments every 10 weeks).
+ */
+
+const WEEKS_PER_TERM = 10;
+const MS_PER_WEEK = 7 * 24 * 60 * 60 * 1000;
+
+// Raise these as more of the curriculum sequence + matching item bank content
+// is generated (see src/db/seed/seed.ts — currently only Term 1 Week 1 has
+// curriculumSequenceEntries rows for Year 3 Maths/English). Until then, clamp
+// here rather than letting a long-enrolled child's computed week run ahead
+// into a week with no "new skill" entries and no items — that would leave
+// them with an empty (or review-only, once they have prior state) session.
+const MAX_AVAILABLE_TERM = 1;
+const MAX_AVAILABLE_WEEK = 1;
+
+export type TermWeek = { term: number; week: number };
+
+export function computeCurrentTermWeek(enrolledAt: Date | null | undefined, now: Date = new Date()): TermWeek {
+  if (!enrolledAt) return { term: 1, week: 1 };
+
+  const msSince = now.getTime() - enrolledAt.getTime();
+  const weeksSince = Math.max(0, Math.floor(msSince / MS_PER_WEEK));
+
+  const term = Math.floor(weeksSince / WEEKS_PER_TERM) + 1;
+  const week = (weeksSince % WEEKS_PER_TERM) + 1;
+
+  if (term > MAX_AVAILABLE_TERM) {
+    return { term: MAX_AVAILABLE_TERM, week: MAX_AVAILABLE_WEEK };
+  }
+  return { term, week: Math.min(week, MAX_AVAILABLE_WEEK) };
+}
