diff --git a/src/app/api/children/route.ts b/src/app/api/children/route.ts
new file mode 100644
index 0000000..eede0bb
--- /dev/null
+++ b/src/app/api/children/route.ts
@@ -0,0 +1,104 @@
+import { NextRequest, NextResponse } from "next/server";
+import { eq } from "drizzle-orm";
+import { db } from "@/db/client";
+import { users, parentChildLinks } from "@/db/schema";
+
+/**
+ * Parent onboarding: add-a-child + list-children.
+ *
+ * There's no real auth yet (see README "Explicit next steps" — Clerk is
+ * planned but not wired up), so parentId is passed explicitly rather than
+ * derived from a session. Once auth lands, swap the parentId source for the
+ * authenticated user's id and these handlers stay the same otherwise.
+ */
+
+const VALID_STATES = ["VIC", "NSW"] as const;
+const CONTENT_YEAR_LEVELS = [3]; // only Year 3 has real curriculum content so far
+
+// GET /api/children?parentId=...
+export async function GET(req: NextRequest) {
+  const parentId = req.nextUrl.searchParams.get("parentId");
+  if (!parentId) {
+    return NextResponse.json({ error: "parentId query param is required" }, { status: 400 });
+  }
+
+  const rows = await db
+    .select({ child: users, link: parentChildLinks })
+    .from(parentChildLinks)
+    .innerJoin(users, eq(parentChildLinks.childId, users.id))
+    .where(eq(parentChildLinks.parentId, parentId));
+
+  return NextResponse.json({
+    children: rows.map((r) => ({
+      id: r.child.id,
+      displayName: r.child.displayName,
+      yearLevel: r.child.yearLevel,
+      state: r.child.state,
+      enrolledAt: r.child.enrolledAt,
+    })),
+  });
+}
+
+// POST /api/children  { parentId, displayName, yearLevel, state }
+export async function POST(req: NextRequest) {
+  const body = await req.json().catch(() => null);
+  if (!body) {
+    return NextResponse.json({ error: "Invalid JSON body" }, { status: 400 });
+  }
+
+  const { parentId, displayName, yearLevel, state } = body as {
+    parentId?: string;
+    displayName?: string;
+    yearLevel?: number;
+    state?: string;
+  };
+
+  if (!parentId || !displayName || !yearLevel || !state) {
+    return NextResponse.json(
+      { error: "parentId, displayName, yearLevel, and state are all required" },
+      { status: 400 }
+    );
+  }
+  if (!VALID_STATES.includes(state as any)) {
+    return NextResponse.json({ error: `state must be one of ${VALID_STATES.join(", ")}` }, { status: 400 });
+  }
+  if (!Number.isInteger(yearLevel) || yearLevel < 1 || yearLevel > 6) {
+    return NextResponse.json({ error: "yearLevel must be an integer from 1 to 6" }, { status: 400 });
+  }
+
+  const parent = await db.select().from(users).where(eq(users.id, parentId)).limit(1);
+  if (!parent[0]) {
+    return NextResponse.json({ error: `No parent found with id ${parentId}` }, { status: 404 });
+  }
+
+  const now = new Date();
+  const [child] = await db
+    .insert(users)
+    .values({
+      clerkUserId: `pending_${parentId}_${now.getTime()}`, // placeholder until real auth is wired up
+      email: parent[0].email,
+      role: "child",
+      state,
+      yearLevel,
+      displayName,
+      enrolledAt: now,
+    })
+    .returning();
+
+  await db.insert(parentChildLinks).values({
+    parentId,
+    childId: child.id,
+    relationship: "parent",
+  });
+
+  return NextResponse.json({
+    child: {
+      id: child.id,
+      displayName: child.displayName,
+      yearLevel: child.yearLevel,
+      state: child.state,
+      enrolledAt: child.enrolledAt,
+    },
+    hasContent: CONTENT_YEAR_LEVELS.includes(yearLevel),
+  });
+}
