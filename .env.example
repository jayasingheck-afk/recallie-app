DATABASE_URL="postgresql://user:password@localhost:5432/recallie"

# --- Auth (Clerk) — optional, opt-in --------------------------------------
# Leave both of these unset and the app runs in demo mode: every parent page
# uses a single seeded demo parent account, no sign-in is required, and
# nothing below matters. Set BOTH keys (from a free Clerk account) to turn on
# real parent sign-in — see the "Auth (Clerk)" section in README.md for the
# step-by-step setup. Setting only one is not a supported state.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."
